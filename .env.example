# ============================================
# PRIMARIAMIND - Environment Variables
# ============================================
# Copy this file to .env.local for local development
# For Vercel deployment, add these in Project Settings > Environment Variables

# --------------------------------------------
# SUPABASE (Required)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --------------------------------------------
# OPENAI (Required)
# Get this from: https://platform.openai.com/api-keys
# --------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here

# --------------------------------------------
# APP CONFIG
# --------------------------------------------
# For local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For production (update with your Vercel URL):
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

NEXT_PUBLIC_APP_NAME=PrimariaMind

# --------------------------------------------
# EMERGENCY NOTIFICATIONS (Optional - Future)
# For Twilio integration to send emergency SMS
# --------------------------------------------
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_PHONE_NUMBER=+1234567890
